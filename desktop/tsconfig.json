{
  // Main process and preload (Node). Reuses ../vscode-extension/src/core, so rootDir spans both folders.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    // core imports `yaml`; resolve it from this package so the extension's node_modules isn't needed.
    "paths": { "yaml": ["./node_modules/yaml"] }
  },
  "include": ["src/main", "src/preload", "src/shared"]
}
