{
  "name": "skill-hub-desktop",
  "productName": "Skill Hub",
  "version": "0.1.0",
  "description": "Desktop app for Skill Hub: one library of AI agent skills, applied to every project you work on.",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "demo": "npm run build && tsc -p ./tsconfig.test.json && node scripts/demo.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && tsc -p ./tsconfig.renderer.json && tsc -p ./tsconfig.test.json --noEmit",
    "test": "tsc -p ./tsconfig.test.json && node --test \"out/desktop/test/**/*.test.js\"",
    "icon": "electron scripts/icon.cjs",
    "package": "node scripts/build.mjs --production && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^20.11.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "dev.skillhub.desktop",
    "productName": "Skill Hub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
